# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LINE Login OAuth Credentials
# NOTE (Vercel deployment): add these same variables in your Vercel Project →
# Settings → Environment Variables so the serverless functions (api/line-url.ts,
# api/line-callback.ts) can sign in users. The code falls back to the defaults
# below if they are missing, so the values must match your LINE channel.
LINE_CHANNEL_ID="2011554399"
LINE_CHANNEL_SECRET="90bc8c44027203495663b57c69fdb135"
