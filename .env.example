# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LINE Login OAuth Credentials
# NOTE (Vercel deployment): add these same variables in your Vercel Project →
# Settings → Environment Variables so the serverless functions (api/line-url.ts,
# api/line-callback.ts) can sign in users. The code falls back to the defaults
# below if they are missing, so the values must match your LINE channel.
# ⚠️ These MUST be the SAME channel used for LINE Login + Messaging API/push.
LINE_CHANNEL_ID="2011570170"
LINE_CHANNEL_SECRET="cf0c2877970de62b8f7f0a3d636faed4"

# LINE Messaging API - REQUIRED for real LINE OA push notifications
# Get it from: LINE Developers Console -> Channel (BORROW HUB) -> Messaging API tab
#              -> "Channel access token (long-lived)" -> click "Issue".
# Set this in Vercel Settings -> Environment Variables, otherwise notifications
# stay in-app only (the api/line/push endpoint returns 503).
# NOTE: push messages only reach users who have ADDED your LINE OA as a friend.
# ⚠️ CRITICAL: LINE_CHANNEL_ID + LINE_CHANNEL_SECRET + LINE_CHANNEL_ACCESS_TOKEN
#    must ALL come from the SAME channel where LINE Login is configured.
#    If login uses channel A and the push token is from channel B, push and
#    friendship checks will ALWAYS fail (LINE user IDs are per-channel).
LINE_CHANNEL_ACCESS_TOKEN=""
